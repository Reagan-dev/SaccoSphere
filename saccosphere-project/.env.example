# =========================
# Django Core
# =========================
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:8081
CSRF_TRUSTED_ORIGINS=https://your-domain.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Gunicorn worker count for the Procfile `web` process (Procfile passes it
# as --workers). Previously unset, which left it on gunicorn's own default
# of a single synchronous worker - one slow request (a Daraja/IPRS call, a
# WeasyPrint PDF render) would block the entire web process. Tune per
# available CPU on the Railway plan; 3 is a starting point, not a measured
# value. GUNICORN_TIMEOUT is the per-request kill timeout in seconds -
# raised above gunicorn's 30s default to give outbound M-Pesa/IPRS calls
# room to complete.
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60

# =========================
# Database
# =========================
DATABASE_URL=postgres://saccosphere:saccosphere@localhost:5432/saccosphere

# =========================
# Redis / Celery
# =========================
REDIS_URL=redis://127.0.0.1:6379/0

# Worker pool size for the Procfile `worker` process (Procfile passes it
# as --concurrency). Previously unset, which left it on Celery's default
# (CPU-count-based) - unmanaged and inconsistent across Railway plan
# sizes for a worker carrying the payments queue. Tune per available
# memory/CPU on the worker dyno; 4 is a starting point, not a measured
# value.
CELERY_WORKER_CONCURRENCY=4

# =========================
# M-Pesa (Daraja)
# =========================
# Set these from your own Daraja app (sandbox or production) -
# never commit real values here. MPESA_SHORTCODE=174379 and the passkey
# below are Safaricom's own published sandbox test values, safe to keep
# as a default; MPESA_CONSUMER_KEY/SECRET and MPESA_B2C_SECURITY_CREDENTIAL
# are per-app secrets and must be left blank or set to a placeholder.
MPESA_CONSUMER_KEY=change-me
MPESA_CONSUMER_SECRET=change-me
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_BASE_URL=https://your-ngrok-or-public-url.example
GUARANTOR_RESPONSE_BASE_URL=https://your-ngrok-or-public-url.example
MPESA_B2C_INITIATOR_NAME=change-me
MPESA_B2C_SECURITY_CREDENTIAL=change-me

# =========================
# Africa's Talking (SMS)
# =========================
AT_USERNAME=sandbox
AT_API_KEY=

# =========================
# Firebase Cloud Messaging (HTTP v1 API - service account, not a legacy
# server key)
# =========================
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# =========================
# IPRS
# =========================
IPRS_API_KEY=
IPRS_API_URL=https://iprs-mock.saccosphere.dev/verify
IPRS_MOCK=True

# =========================
# Email
# =========================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=SaccoSphere <no-reply@saccosphere.co.ke>
OTP_EMAIL_ENABLED=False

# =========================
# Sentry
# =========================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# =========================
# Billing / Collections
# =========================
BILLING_ACCOUNT_NAME=Realwinners Ltd
BILLING_ACCOUNT_NUMBER=0123456789
BILLING_PAYBILL=400200
BILLING_SUPPORT_EMAIL=billing@saccosphere.co.ke

# =========================
# Payments / Fee Configuration
# =========================
DISBURSEMENT_TIERS=[[10000,"50"],[30000,"100"],[70000,"200"],[150000,"350"],[300000,"500"],[null,"750"]]
WITHDRAWAL_TIERS=[[2000,"15"],[5000,"25"],[10000,"40"],[20000,"60"],[null,"100"]]
FEE_DEPOSIT_RATE=0.01
FEE_REPAYMENT_RATE=0.005
